// The hosted CityParquet MCP server: a Worker fronting a Cloudflare Container.
// Deployed by .github/workflows/mcp-deploy.yml; needs the Workers Paid plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cityparquet-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "CityParquetMcp",
      // Built from ai/mcp alone; the corpus is committed, so no submodule.
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MCP", "class_name": "CityParquetMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CityParquetMcp"] }]
}
