{
  "name": "@cityjson/cityparquet-mcp",
  "version": "0.1.0",
  "description": "MCP server for CityParquet: the specification, the DuckDB extensions' function references, and a DuckDB engine to describe and query 3D city models",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityjson/cityparquet.git",
    "directory": "ai/mcp"
  },
  "homepage": "https://github.com/cityjson/cityparquet/tree/main/ai/mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cityparquet",
    "cityjson",
    "duckdb",
    "3d-city-models"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "cityparquet-mcp": "./dist/stdio.js",
    "cityparquet-mcp-http": "./dist/http.js"
  },
  "files": [
    "dist",
    "corpus",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "corpus": "pnpm build && node dist/build-corpus.js",
    "corpus:check": "pnpm build && node dist/check-corpus-fresh.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "serve": "node dist/http.js"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
