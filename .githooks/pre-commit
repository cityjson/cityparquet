#!/usr/bin/env bash
# Formats the staged Rust and Markdown before every commit: rustfmt via
# `cargo fmt`, Markdown via Prettier. Install with `just hooks` (sets
# core.hooksPath); it is not active in a fresh clone until you run that.
#
# Paths here are MONOREPO-relative — a hook runs with the working directory at
# the enclosing repository's root. The Rust half therefore has to pick a
# workspace before it can format anything: the tree holds two independent ones
# (`lib/cityparquet-rs` and `lib/citylake`, see the migration note's D6), so a
# bare `cargo fmt --all` at the root has no manifest to work from at all.
#
# Prettier is pinned exactly — a floating minor changes Markdown output and
# would churn files nobody edited.
set -euo pipefail

PRETTIER_VERSION=3.9.6

# Every Cargo workspace in the tree, as `<path prefix>` — a staged `.rs` under
# one of these is formatted with that workspace's manifest.
WORKSPACES=(lib/cityparquet-rs lib/citylake benchmark/readbench)

staged_rust=()
staged_md=()
while IFS= read -r -d '' path; do
    case "${path}" in
        # Vendored and submodule trees are upstream projects with their own
        # formatting; never rewrite them from here.
        */vendor/*) continue ;;
        lib/duckdb-cityjson/*|lib/duckdb-3d/*) continue ;;
        *.rs) staged_rust+=("${path}") ;;
        *.md) staged_md+=("${path}") ;;
    esac
done < <(git diff --cached -z --name-only --diff-filter=ACMR)

if [[ ${#staged_rust[@]} -eq 0 && ${#staged_md[@]} -eq 0 ]]; then
    exit 0
fi

# Files staged with further unstaged edits on top: re-staging them after
# formatting would silently sweep those edits into the commit, so refuse
# rather than commit something the author never reviewed.
dirty=()
while IFS= read -r -d '' path; do
    dirty+=("${path}")
done < <(git diff -z --name-only)

is_dirty() {
    local needle="$1" path
    for path in ${dirty[@]+"${dirty[@]}"}; do
        [[ "${path}" == "${needle}" ]] && return 0
    done
    return 1
}

conflicted=()
for path in ${staged_rust[@]+"${staged_rust[@]}"} ${staged_md[@]+"${staged_md[@]}"}; do
    is_dirty "${path}" && conflicted+=("${path}")
done
if [[ ${#conflicted[@]} -gt 0 ]]; then
    echo "pre-commit: these files are partially staged, so formatting them would" >&2
    echo "stage edits you did not select. Stage them fully, or stash the rest:" >&2
    printf '  %s\n' "${conflicted[@]}" >&2
    exit 1
fi

if [[ ${#staged_rust[@]} -gt 0 ]]; then
    # A staged `.rs` outside every known workspace is a new tree nobody taught
    # this hook about — say so rather than leave it silently unformatted.
    unclaimed=()
    for path in "${staged_rust[@]}"; do
        claimed=0
        for ws in "${WORKSPACES[@]}"; do
            [[ "${path}" == "${ws}/"* ]] && claimed=1 && break
        done
        [[ "${claimed}" -eq 0 ]] && unclaimed+=("${path}")
    done
    if [[ ${#unclaimed[@]} -gt 0 ]]; then
        echo "pre-commit: staged Rust outside every known Cargo workspace:" >&2
        printf '  %s\n' "${unclaimed[@]}" >&2
        echo "Add its workspace to WORKSPACES in .githooks/pre-commit." >&2
        exit 1
    fi

    for ws in "${WORKSPACES[@]}"; do
        for path in "${staged_rust[@]}"; do
            if [[ "${path}" == "${ws}/"* ]]; then
                cargo fmt --all --manifest-path "${ws}/Cargo.toml"
                break
            fi
        done
    done
fi

if [[ ${#staged_md[@]} -gt 0 ]]; then
    if ! command -v npx >/dev/null 2>&1; then
        echo "pre-commit: npx not found; Prettier formats the staged Markdown." >&2
        echo "Install Node, or commit without Markdown changes." >&2
        exit 1
    fi
    npx --yes "prettier@${PRETTIER_VERSION}" --log-level warn --write "${staged_md[@]}"
fi

git add -- ${staged_rust[@]+"${staged_rust[@]}"} ${staged_md[@]+"${staged_md[@]}"}
