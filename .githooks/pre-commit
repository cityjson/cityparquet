#!/usr/bin/env bash
# Formats the staged Rust and Markdown before every commit: rustfmt via
# `cargo fmt`, Markdown via Prettier. Install with `just hooks` (sets
# core.hooksPath); it is not active in a fresh clone until you run that.
#
# Prettier is pinned exactly — a floating minor changes Markdown output and
# would churn files nobody edited.
set -euo pipefail

PRETTIER_VERSION=3.9.6

staged_rust=()
staged_md=()
while IFS= read -r -d '' path; do
    case "${path}" in
        vendor/*) continue ;;
        *.rs) staged_rust+=("${path}") ;;
        *.md) staged_md+=("${path}") ;;
    esac
done < <(git diff --cached -z --name-only --diff-filter=ACMR)

if [[ ${#staged_rust[@]} -eq 0 && ${#staged_md[@]} -eq 0 ]]; then
    exit 0
fi

# Files staged with further unstaged edits on top: re-staging them after
# formatting would silently sweep those edits into the commit, so refuse
# rather than commit something the author never reviewed.
dirty=()
while IFS= read -r -d '' path; do
    dirty+=("${path}")
done < <(git diff -z --name-only)

is_dirty() {
    local needle="$1" path
    for path in ${dirty[@]+"${dirty[@]}"}; do
        [[ "${path}" == "${needle}" ]] && return 0
    done
    return 1
}

conflicted=()
for path in ${staged_rust[@]+"${staged_rust[@]}"} ${staged_md[@]+"${staged_md[@]}"}; do
    is_dirty "${path}" && conflicted+=("${path}")
done
if [[ ${#conflicted[@]} -gt 0 ]]; then
    echo "pre-commit: these files are partially staged, so formatting them would" >&2
    echo "stage edits you did not select. Stage them fully, or stash the rest:" >&2
    printf '  %s\n' "${conflicted[@]}" >&2
    exit 1
fi

if [[ ${#staged_rust[@]} -gt 0 ]]; then
    cargo fmt --all
fi

if [[ ${#staged_md[@]} -gt 0 ]]; then
    if ! command -v npx >/dev/null 2>&1; then
        echo "pre-commit: npx not found; Prettier formats the staged Markdown." >&2
        echo "Install Node, or commit without Markdown changes." >&2
        exit 1
    fi
    npx --yes "prettier@${PRETTIER_VERSION}" --log-level warn --write "${staged_md[@]}"
fi

git add -- ${staged_rust[@]+"${staged_rust[@]}"} ${staged_md[@]+"${staged_md[@]}"}
