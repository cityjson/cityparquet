# Every container call goes through the engine cascade (Apple `container` >
# docker > podman; override with CITYBENCH_CONTAINER_ENGINE). See src/citybench/engine.py.
engine := `uv run --quiet python -m citybench.engine binary 2>/dev/null || echo podman`
compose := "`uv run --quiet python -m citybench.engine compose` -f docker/compose.yml"

# All mutable database state is an explicit bind mount below the shared
# benchmark data root, never a named Podman volume.
[private]
isolated-up DATA_ROOT SRID:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{DATA_ROOT}}"
    allowed="$(cd .. && pwd)/runs"
    case "$root" in "$allowed"|"$allowed"/*) ;; *) echo "DATA_ROOT must be below $allowed" >&2; exit 2;; esac
    db_root="$root/databases"
    mkdir -p "$db_root"
    rm -rf "$db_root/cjdb" "$db_root/citydb"
    mkdir -p "$db_root/cjdb" "$db_root/citydb"
    CITYBENCH_DB_ROOT="$db_root" CITYDB_SRID="{{SRID}}" {{compose}} up -d

[private]
isolated-down DATA_ROOT:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{DATA_ROOT}}"
    allowed="$(cd .. && pwd)/runs"
    case "$root" in "$allowed"|"$allowed"/*) ;; *) echo "DATA_ROOT must be below $allowed" >&2; exit 2;; esac
    CITYBENCH_DB_ROOT="$root/databases" {{compose}} down

# Start both benchmark databases and wait for REAL readiness.
#
# I6 (final whole-branch review): `podman-compose up -d --wait` does not
# actually wait here -- observed returning in ~8s with exit -1 on both
# services while PostgreSQL still refused connections (podman-compose's
# `--wait` support is inconsistent with the healthcheck: block shape this
# compose file uses; README previously claimed it worked). Replaced with
# an explicit readiness poll: `pg_isready` against both ports, then a wait
# for `citydb`'s v5 schema to actually exist -- the 3dcitydb-pg image
# builds that schema asynchronously on first start, AFTER postgres already
# accepts connections, so `pg_isready` alone is not sufficient for that
# container specifically (see docs/3dcitydb-v5-schema.md). `just up`
# returning means "ready to import into", not merely "containers exist".
up:
    #!/usr/bin/env bash
    set -euo pipefail
    {{compose}} up -d
    echo "waiting for cjdb (55432) ..."
    until pg_isready -h localhost -p 55432 -U bench -d bench -q; do sleep 1; done
    echo "waiting for citydb (55433) ..."
    until pg_isready -h localhost -p 55433 -U bench -d bench -q; do sleep 1; done
    echo "waiting for citydb's v5 schema (feature, property, geometry_data, objectclass) ..."
    until [ "$(PGPASSWORD=bench psql -h localhost -p 55433 -U bench -d bench -tAc \
        "SELECT count(*) FROM information_schema.tables WHERE table_schema='citydb' AND table_name IN ('feature','property','geometry_data','objectclass')")" = "4" ]; do
        sleep 1
    done
    echo "both databases ready"

down:
    {{compose}} down -v

# Build the pinned citydb-tool image.
build-citydb:
    {{engine}} build -t citybench/citydb-tool -f docker/citydb.Dockerfile docker/

# Build the patched cjdb CjdbSystem drives (see vendor/cjdb/README.md).
# Must be run once before any cjdb ingest (`just smoke`/`just bench`).
patch-cjdb:
    ./scripts/patch_cjdb.sh

test:
    uv run pytest -m "not integration" -v

test-all:
    uv run pytest -v

# Capture both databases' real schemas into committed reference docs.
capture-schema DATASET:
    ./scripts/capture_schema.sh {{DATASET}}

# Isolation (see README "Host isolation"): NUMA_NODE is a node id, `auto`
# (most MemFree at run start; env BENCH_NUMA_NODE overrides the default) or
# `off`; MAX_LOAD is a load threshold, `auto` (half the node's cores) or `off`.
# DATASETS: `all`, or comma-separated manifest ids / source stems, each read
# from PREPARED as <stem>.city.jsonl; one CSV + manifest per dataset id.
bench-datasets DATASETS PREPARED='../runs/data/readbench' REPEAT='25' NUMA_NODE=env_var_or_default('BENCH_NUMA_NODE', 'auto') MAX_LOAD='auto' MAX_LOAD_WAIT_S='600':
    uv run python -m citybench.cli run --datasets {{DATASETS}} --prepared-dir {{PREPARED}} --repeat {{REPEAT}} --numa-node {{NUMA_NODE}} --max-load {{MAX_LOAD}} --max-load-wait-s {{MAX_LOAD_WAIT_S}}

bench DATASET REPEAT='25' NUMA_NODE=env_var_or_default('BENCH_NUMA_NODE', 'auto') MAX_LOAD='auto' MAX_LOAD_WAIT_S='600':
    uv run python -m citybench.cli run --dataset {{DATASET}} --repeat {{REPEAT}} --numa-node {{NUMA_NODE}} --max-load {{MAX_LOAD}} --max-load-wait-s {{MAX_LOAD_WAIT_S}}

# Full pipeline on the small fixture. Must pass before any long run.
smoke:
    uv run python -m citybench.cli smoke
