# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.superpowers/

/tests/fixtures/
# Benchmark input data is fetched (scripts/fetch_3dbag.sh) and stays out of
# git; bench/results/*.csv and bench/README.md ARE committed — they are the
# paper's measurement artefacts.
/bench/data/

# External converters fetched by scripts/fetch_tools.sh (citygml-tools). The
# PINS live in that script, which IS committed; the unpacked ~28 MB of JARs
# does not.
/bench/tools/

# CityParquet packages produced by `just convert-all` (default OUT root)
/out/

# Generated read-benchmark charts (`just plot`/`just bench`) — the
# committed inputs are the CSVs under bench/read_results/, not these PNGs.
/bench/**/plots/

# bench/plot/'s own uv-managed venv + Python bytecode cache — its source
# (pyproject.toml, *.py, uv.lock) IS committed.
/bench/plot/.venv/
**/__pycache__/

# tools/catalog2cityparquet/'s own uv-managed venv + pytest cache — its source
# (pyproject.toml, *.py, uv.lock) IS committed.
/tools/catalog2cityparquet/.venv/
**/.pytest_cache/


.DS_Store