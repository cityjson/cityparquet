# Copy to `.env.local` and fill in real values.
# These are read at build time by Vite (anything starting with VITE_ is exposed to the browser).

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (NOT the service role key)
VITE_SUPABASE_ANON_KEY=

# Where the CityLake server lives. Leave empty to use the dev proxy at /api.
VITE_API_BASE_URL=
