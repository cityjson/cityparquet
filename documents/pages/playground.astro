---
// The SQL playground at /playground.
//
// Chrome comes from PageLayout, the same header the landing page uses, so the
// logo, search, GitHub link and theme toggle are shared. The playground itself
// is a React island: DuckDB-Wasm needs Worker and window, so it is mounted with
// `client:only` and never server-rendered.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Playground from "../playground/Playground.tsx";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "SQL playground — query CityParquet in your browser",
    description:
      "Run SQL against 16.4 GB of 3DBAG on object storage, with DuckDB-Wasm and the cityjson and three_d extensions. Nothing is installed and nothing is uploaded.",
    route: "/playground",
  }}
>
  <Playground client:only="react" />
</PageLayout>

<style is:global>
  /* Local tokens, resolved from the site's own theme variables so the
     playground follows light/dark and the accent without redefining them. */
  .cp-playground {
    --cp-mono: var(--blume-font-mono, ui-monospace, SFMono-Regular, monospace);
    --cp-border: var(--blume-color-border, color-mix(in srgb, currentColor 14%, transparent));
    --cp-surface: var(--blume-color-surface, color-mix(in srgb, currentColor 3%, transparent));
    /* The page's own ground. Needed wherever something has to be opaque over
       scrolling content — `--cp-surface` is a 3% tint, not a background. */
    --cp-page: var(--blume-background, Canvas);
    --cp-hover: color-mix(in srgb, currentColor 6%, transparent);
    --cp-dim: color-mix(in srgb, currentColor 55%, transparent);
    --cp-accent: var(--blume-color-primary, #7253ed);

    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 90rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .cp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cp-header h1 {
    margin: 0 0 0.35rem;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .cp-subtitle {
    margin: 0;
    max-width: 60ch;
    color: var(--cp-dim);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .cp-subtitle code {
    font-family: var(--cp-mono);
    font-size: 0.85em;
  }

  .cp-run {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 4px;
    background: var(--cp-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .cp-run:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .cp-run kbd {
    font-family: var(--cp-mono);
    font-size: 0.75em;
    opacity: 0.8;
  }

  /* Three columns on a wide screen; stacked below. */
  .cp-layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr) 15rem;
    gap: 1rem;
    align-items: start;
  }

  @media (max-width: 1100px) {
    .cp-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .cp-schema {
      order: 3;
    }
  }

  /* Presets */
  .cp-presets {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-height: 44rem;
    overflow-y: auto;
  }

  .cp-preset-group-title {
    margin: 0 0 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cp-dim);
  }

  .cp-presets ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cp-preset {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.5rem 0.6rem;
    border: 1px solid transparent;
    border-radius: 4px;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .cp-preset:hover {
    background: var(--cp-hover);
  }

  .cp-preset-active {
    border-color: var(--cp-accent);
    background: color-mix(in srgb, var(--cp-accent) 10%, transparent);
  }

  .cp-preset-title {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cp-preset-blurb {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--cp-dim);
  }

  /* Editor */
  .cp-main {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .cp-editor-shell {
    border: 1px solid var(--cp-border);
    border-radius: 4px;
    background: var(--cp-surface);
    min-height: 14rem;
    max-height: 28rem;
    overflow: auto;
  }

  .cp-editor {
    height: 100%;
  }

  /* Status bar */
  .cp-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--cp-dim);
    min-height: 1.6rem;
  }

  .cp-status-metrics,
  .cp-status-extensions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .cp-status-item strong {
    color: inherit;
    font-variant-numeric: tabular-nums;
  }

  .cp-running {
    color: var(--cp-accent);
  }

  .cp-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--cp-border);
    border-radius: 999px;
    font-family: var(--cp-mono);
    font-size: 0.7rem;
  }

  .cp-badge-version {
    opacity: 0.65;
  }

  .cp-badge-failed {
    border-style: dashed;
    opacity: 0.7;
  }

  /* Results */
  .cp-table-scroll {
    /* Both axes, and a ceiling on the vertical one: a result is a panel on the
       page rather than something that stretches it. The sticky header below
       only does anything because of this. */
    overflow: auto;
    max-height: min(60vh, 34rem);
    border: 1px solid var(--cp-border);
    border-radius: 4px;
  }

  .cp-table {
    border-collapse: collapse;
    width: max-content;
    min-width: 100%;
    font-size: 0.8rem;
    font-family: var(--cp-mono);
  }

  .cp-table th,
  .cp-table td {
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--cp-border);
    text-align: left;
    white-space: nowrap;
    max-width: 32rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cp-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    /* Opaque, or the rows scroll through the header. The separator is a shadow
       rather than a border because under `border-collapse: collapse` a sticky
       cell's own border scrolls away with the rows it was collapsed against. */
    background-color: var(--cp-page);
    background-image: linear-gradient(var(--cp-surface), var(--cp-surface));
    box-shadow: inset 0 -1px 0 var(--cp-border);
    font-weight: 600;
  }

  .cp-table tbody tr:hover {
    background: var(--cp-hover);
  }

  .cp-rownum {
    color: var(--cp-dim);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .cp-null {
    color: var(--cp-dim);
    font-style: italic;
  }

  .cp-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }

  .cp-page-button {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--cp-border);
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .cp-page-button:hover:not(:disabled) {
    background: var(--cp-hover);
  }

  .cp-page-button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .cp-page-count {
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--cp-dim);
  }

  .cp-truncated,
  .cp-empty {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--cp-dim);
  }

  .cp-empty {
    padding: 1.5rem 0;
  }

  /* Schema panel */
  .cp-schema {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 44rem;
    overflow-y: auto;
  }

  .cp-schema-title {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cp-dim);
  }

  .cp-dim-text {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--cp-dim);
  }

  .cp-schema-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cp-schema-item {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.25rem 0.35rem;
    border: none;
    border-radius: 3px;
    background: none;
    color: inherit;
    font-family: var(--cp-mono);
    font-size: 0.72rem;
    cursor: pointer;
    text-align: left;
  }

  .cp-schema-item:hover {
    background: var(--cp-hover);
  }

  .cp-schema-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cp-schema-type {
    color: var(--cp-dim);
    white-space: nowrap;
  }

  /* Boot and errors */
  .cp-boot {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 2.5rem 0;
    font-size: 0.9rem;
    color: var(--cp-dim);
  }

  .cp-spinner {
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--cp-border);
    border-top-color: var(--cp-accent);
    border-radius: 50%;
    animation: cp-spin 0.8s linear infinite;
  }

  @keyframes cp-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-spinner {
      animation-duration: 2.4s;
    }
  }

  .cp-error {
    border: 1px solid color-mix(in srgb, #d94f4f 45%, var(--cp-border));
    border-radius: 4px;
    padding: 0.85rem 1rem;
    background: color-mix(in srgb, #d94f4f 6%, transparent);
  }

  .cp-error h2 {
    margin: 0 0 0.45rem;
    font-size: 0.9rem;
  }

  .cp-error pre {
    margin: 0;
    padding: 0.5rem 0.6rem;
    overflow-x: auto;
    border-radius: 3px;
    background: var(--cp-surface);
    font-family: var(--cp-mono);
    font-size: 0.76rem;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .cp-error p {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--cp-dim);
  }

  .cp-footer {
    font-size: 0.75rem;
    color: var(--cp-dim);
  }

  .cp-footer p {
    margin: 0;
  }

  .cp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
