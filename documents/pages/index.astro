  .cp-terminal-rest {
    visibility: hidden;
  }

  /* The block cursor is drawn only while the query is being typed, so the
     finished panel reads as output rather than as a waiting prompt. */
  [data-cp-phase="typing"] .cp-terminal-cursor::after {
    content: "▋";
    color: var(--cp-accent);
  }

  .cp-terminal-result {
