  const target = document.querySelector<HTMLElement>("[data-cp-typed]");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (target && !still) {
    const phrases = [
      "no database",
      "no server",
      "globally scalable",
      "ultra fast",
    ];
    let index = 0;
    let count = phrases[0].length;
    let deleting = true;

    const tick = () => {
      const word = phrases[index];
      let delay: number;

      if (!deleting) {
        if (count < word.length) {
          count += 1;
          delay = 62;
        } else {
          deleting = true;
          delay = 1400;
        }
      } else if (count > 0) {
        count -= 1;
        delay = 28;
      } else {
        index = (index + 1) % phrases.length;
        deleting = false;
        delay = 220;
      }

      target.textContent = phrases[index].slice(0, count);
      setTimeout(tick, delay);
    };

    setTimeout(tick, 1400);
  }

  // Replays the section-04 query: type it out, spin briefly, reveal the result,
  // hold, restart. The figures it reveals are server-rendered and real — this
  // only stages when they appear. Under reduced motion the CSS already shows
  // the finished state, so the replay never starts.
  const terminal = document.querySelector<HTMLElement>("[data-cp-terminal]");
  const rest = terminal?.querySelector<HTMLElement>("[data-sql-rest]");
  const typed = terminal?.querySelector<HTMLElement>("[data-sql-typed]");
  const label = terminal?.querySelector<HTMLElement>("[data-sql-label]");

  if (terminal && rest && typed && label && !still) {
    type Phase = "typing" | "running" | "result";

    const sql = typed.textContent ?? "";
    const doneLabel = label.textContent ?? "";
    const scanning = terminal.dataset.scanning ?? "";
    let n = 0;
    let phase: Phase = "typing";

    // Captured before the first paint, while every token still holds its full
    // text. Revealing means trimming each token in place -- rewriting `typed`
    // wholesale would throw the highlight away on the first keystroke.
    const toks = [...typed.querySelectorAll<HTMLElement>("[data-sql-tok]")];
    const full = toks.map((el) => el.textContent ?? "");

    const paint = () => {
      let left = n;
      toks.forEach((el, i) => {
        const text = full[i];
        const shown = text.slice(0, Math.max(0, Math.min(text.length, left)));
        if (el.textContent !== shown) el.textContent = shown;
        left -= text.length;
      });
      rest.textContent = sql.slice(n);
      terminal.dataset.cpPhase = phase;
      label.textContent =
        phase === "typing"
          ? "typing query"
          : phase === "running"
            ? scanning
            : doneLabel;
    };

    // The delay is how long the CURRENT phase holds; the next state is applied
    // when it elapses. Computing it the other way round would blank the result
    // the instant it appeared and then idle for five seconds.
    const step = () => {
      let nextN = n;
      let nextPhase = phase;
      let delay: number;

      if (phase === "typing") {
        if (n < sql.length) {
          const newline = sql[n] === "\n";
          nextN = Math.min(n + (newline ? 1 : 2), sql.length);
          delay = newline ? 130 : 16;
        } else {
          nextPhase = "running";
          delay = 520;
        }
      } else if (phase === "running") {
        nextPhase = "result";
        delay = 900;
      } else {
        nextPhase = "typing";
        nextN = 0;
        delay = 5200;
      }

      setTimeout(() => {
        n = nextN;
        phase = nextPhase;
        paint();
        step();
      }, delay);
    };

    paint();
    step();
  }
</script>
