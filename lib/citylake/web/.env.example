# Copy to your workspace-root .env (or .env.local for plaintext) and fill in.
# These are read at build time by Vite (anything starting with VITE_ is exposed
# to the browser). The two Supabase values below are public by design — the
# anon/publishable key is meant to be visible to the client.
#
# Vite's config also accepts the unprefixed forms (SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY, SUPABASE_KEY) so a single
# workspace-root .env shared with the Rust server doesn't need duplication.

# Supabase project URL — Settings → Project URL
VITE_SUPABASE_URL=

# Supabase publishable key — Settings → API → anon/public key
# (Supabase recently renamed "anon key" → "publishable key" in the dashboard;
#  the underlying JWT is unchanged.)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: where the CityLake server lives. Leave empty in dev to use the
# Vite proxy at /api → http://127.0.0.1:3000.
VITE_API_BASE_URL=
